# oja-backend API origin. Same env var name oja-landing-page uses.
NEXT_PUBLIC_ECOM_APP_API_URL=

# Main merchant/buyer app (oja-frontend) — sign-in, signup. Defaults to
# https://app.useoja.com in production if unset.
NEXT_PUBLIC_MAIN_APP_URL=

# Root domain store subdomains live on. Defaults to useoja.com — only
# override this if that ever changes.
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=

# This app's own public URL, for metadata/sitemap/robots canonical links.
# Defaults to https://oja.com.ng in production if unset.
NEXT_PUBLIC_SITE_URL=
